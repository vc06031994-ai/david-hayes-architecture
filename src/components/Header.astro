---
const navItems = [
  { label: 'Services', href: '#services' },
  { label: 'Studio', href: '#studio' },
  { label: 'Insights', href: '#insights' },
  { label: 'Service Areas', href: '#service-areas' },
  { label: 'About Us', href: '#about' },
  { label: 'Rayon', href: '/rayon/' },
];
---
<div class="site-topbar" aria-label="Website selection">
  <nav class="site-tabs" aria-label="Choose website">
    <a class="site-tab is-active" href="/" aria-current="page">Personal</a>
    <a class="site-tab" href="/rayon/">Rayon</a>
  </nav>
</div>
<header class="site-header">
  <a class="brand" href="/" aria-label="David Hayes Architecture and Design home">
    <span class="brand-mark" aria-hidden="true">DH<span class="brand-slash">/</span>AD</span>
    <span class="brand-description">David Hayes<br />Architecture &amp; Design</span>
  </a>
  <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-navigation">
    <span></span><span></span>
  </button>
  <nav class="primary-navigation" id="primary-navigation" aria-label="Main navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <span class="nav-divider" aria-hidden="true"></span>
    <a class="phone-link" href="tel:2564861529" aria-label="Call 256 486 1529">
      <span class="phone-icon" aria-hidden="true">☎</span><span>2564861529</span>
    </a>
    <a class="header-cta" href="#start-project">Start a Project</a>
  </nav>
</header>
<style>
.site-topbar{position:relative;z-index:5;height:var(--topbar-height);display:flex;align-items:stretch;padding-inline:var(--content-gutter);background:rgba(43,43,43,.94);color:#fff}
.site-tabs{display:flex;height:100%;align-items:stretch}
.site-tab{min-width:5.5rem;display:inline-flex;justify-content:center;align-items:center;padding-inline:1rem;color:#fff;text-decoration:none;font-size:.9rem;font-weight:400;border-bottom:.125rem solid transparent;transition:background-color .2s ease,border-color .2s ease}
.site-tab:hover{background:rgba(255,255,255,.1)}
.site-tab.is-active{background:rgba(255,255,255,.12);border-bottom-color:var(--color-primary)}
.site-header{position:absolute;z-index:4;inset:var(--topbar-height) 0 auto;min-height:var(--header-height);display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:.65rem var(--content-gutter);color:#fff;background:rgba(255,255,255,.16);border-bottom:.0625rem solid rgba(255,255,255,.2)}
.brand{display:inline-flex;flex:0 0 auto;align-items:center;gap:.6rem;color:#fff;text-decoration:none}
.brand-mark{display:inline-flex;align-items:center;white-space:nowrap;font-size:1.35rem;line-height:1;font-weight:400;letter-spacing:-.045em}
.brand-slash{margin-inline:.12rem;font-weight:300}
.brand-description{font-size:.65rem;line-height:1.3;font-weight:400;white-space:nowrap}
.primary-navigation{display:flex;align-items:center;justify-content:flex-end;gap:clamp(.8rem,1.8vw,1.65rem)}
.primary-navigation>a:not(.header-cta){color:#fff;font-size:.9rem;line-height:1.3;text-decoration:none;white-space:nowrap;transition:opacity .2s ease}
.primary-navigation>a:not(.header-cta):hover{opacity:.72}
.nav-divider{width:.0625rem;height:1.25rem;background:rgba(255,255,255,.75)}
.phone-link{display:inline-flex;align-items:center;gap:.45rem}
.phone-icon{display:inline-grid;place-items:center;width:1rem;height:1rem;border-radius:50%;background:#fff;color:#333;font-size:.68rem}
.header-cta{min-height:2rem;display:inline-flex;align-items:center;justify-content:center;padding:.5rem .9rem;background:#fff;color:#222;font-size:.86rem;text-decoration:none;white-space:nowrap;transition:background-color .2s ease}
.header-cta:hover{background:var(--color-background)}
.menu-toggle{display:none}
@media(max-width:64rem){.site-header{gap:1rem}.primary-navigation{gap:.8rem}.primary-navigation>a:not(.header-cta){font-size:.8rem}.brand-mark{font-size:1.2rem}.brand-description{font-size:.58rem}}
@media(max-width:48rem){
.site-header{min-height:var(--header-height);padding-block:.65rem;background:rgba(35,35,35,.42)}
.menu-toggle{width:2.6rem;height:2.6rem;display:inline-flex;flex-direction:column;justify-content:center;align-items:center;gap:.35rem;border:.0625rem solid rgba(255,255,255,.65);background:transparent;cursor:pointer}
.menu-toggle span{width:1.1rem;height:.0625rem;background:#fff;transition:transform .2s ease}
.menu-toggle[aria-expanded=true] span:first-child{transform:translateY(.2rem) rotate(45deg)}
.menu-toggle[aria-expanded=true] span:last-child{transform:translateY(-.2rem) rotate(-45deg)}
.primary-navigation{position:absolute;top:100%;left:0;right:0;display:none;flex-direction:column;align-items:stretch;gap:0;padding:.5rem var(--content-gutter) 1.25rem;background:rgba(35,35,35,.97)}
.primary-navigation.is-open{display:flex}
.primary-navigation>a:not(.header-cta){padding:.85rem 0;font-size:.8rem}
.nav-divider{width:100%;height:.0625rem;margin:.35rem 0}
.phone-link{justify-content:flex-start}
.header-cta{align-self:flex-start;margin-top:.6rem;padding-inline:1.1rem}
}
</style>
<script>
const menuToggle=document.querySelector('.menu-toggle');
const primaryNavigation=document.querySelector('.primary-navigation');
if(menuToggle&&primaryNavigation){
 menuToggle.addEventListener('click',()=>{
  const isOpen=menuToggle.getAttribute('aria-expanded')==='true';
  menuToggle.setAttribute('aria-expanded',String(!isOpen));
  menuToggle.setAttribute('aria-label',isOpen?'Open navigation menu':'Close navigation menu');
  primaryNavigation.classList.toggle('is-open',!isOpen);
 });
 primaryNavigation.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{
  menuToggle.setAttribute('aria-expanded','false');
  menuToggle.setAttribute('aria-label','Open navigation menu');
  primaryNavigation.classList.remove('is-open');
 }));
}
</script>